# Login — stored in the database, not here. Defaults to archer / archer on
# first run; change it from the app's Settings page.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# Private admin portal (/admin) — for setting up new companies. Required to
# use /admin at all; treat it like a password. Generate: openssl rand -hex 24
ADMIN_SECRET=

# Encrypts customer PII (phone, notes, address, street) at rest in Postgres.
# Required before any customer create/edit will succeed once this is
# deployed. Must be the SAME value in every environment that shares this
# database (e.g. Production and Preview, if pointed at the same DB).
# Generate: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Database — Neon/Vercel Postgres (any one of these enables Postgres storage)
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# App timezone for “today”, scheduling, and message greeting (IANA name)
APP_TZ=Europe/London

# Optional: Vercel KV instead of local JSON file
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: override local KV file path
# LOCAL_KV_FILE=.data/local-kv.json
